# ============================================================
# מערכת מכון ילדי הקסם – Environment Variables
# Copy to .env.local for development, set in Railway for production
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.yaldey.co.il
NODE_ENV=development

# --- WhatsApp (WaBox / UltraMsg) ---
WABOX_API_URL=https://www.waboxapp.com/api
WABOX_TOKEN=
WABOX_FROM=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Instagram / Meta ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GCAL_CALENDAR_ID=primary

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_REPORT_MODEL=gpt-4o-2024-08-06
OPENAI_INTENT_MODEL=gpt-4o-mini

# --- MOXO ---
MOXO_API_URL=https://api.moxo.health/v1
MOXO_API_TOKEN=

# --- Airtable ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Security ---
HMAC_SECRET=change-me-to-32-bytes-random-hex
SESSION_SECRET=change-me-to-32-bytes-random-hex

# ============================================================
# --- Marhaba Sales (Nour outbound sales mode) ---
# ============================================================
# WhatsApp number that receives alerts (hot leads, demo bookings, escalations)
BASEEM_PHONE=+972509955137

# Secret for Vercel cron + import-leads endpoints
# Generate with: openssl rand -hex 32
MARHABA_CRON_SECRET=change-me-to-random-hex

# Google Places API key (free tier: 10k text-searches + 5k details/month)
# Create at: https://console.cloud.google.com → Enable Places API → Create API Key
GOOGLE_PLACES_API_KEY=AIza...

# URL to Marhaba 60-second demo video (WhatsApp will link to this)
MARHABA_DEMO_VIDEO_URL=https://marhaba.co.il/demo.mp4

# ElevenLabs (reused — should already be set if Nour is running)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# UltraMsg (reused — should already be set)
ULTRAMSG_INSTANCE_ID=instance...
ULTRAMSG_TOKEN=
