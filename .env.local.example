# =====================================================================
# Yaldey HaKesem - Environment Variables
# =====================================================================
# הוראות:
# 1. שנה את שם הקובץ מ-.env.local.example ל-.env.local
# 2. מלא את הערכים מ-Supabase Dashboard → Project Settings → API
# 3. שמור את הקובץ
# 4. הרץ npm run dev
# =====================================================================

# --- Supabase Configuration ---
# מ-Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# מ-Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# מ-Supabase Dashboard → Project Settings → API → Project API keys → service_role
# ⚠️ שמור בסוד! רק בשרת (server-side), לעולם לא בקוד הלקוח
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Application Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=מכון ילדי הקסם

# --- Timezone ---
TZ=Asia/Jerusalem
